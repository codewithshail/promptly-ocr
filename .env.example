# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication
# Get your keys from https://clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database (Neon DB)
# Get your connection string from https://neon.tech/
DATABASE_URL=

# Cloudinary (for file uploads)
# Get your credentials from https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini AI (REQUIRED)
# Get your API key from https://makersuite.google.com/app/apikey
# Used for: Chatbot, Copy Evaluation, Tips Generation, AI Notes Enhancement
GEMINI_API_KEY=

# Inngest (for background job processing) (REQUIRED)
# Get your keys from https://www.inngest.com/
# For development, you can use the Inngest Dev Server: npx inngest-cli@latest dev
# Used for: Copy processing, News fetching, Tips caching, Quiz generation
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# NewsData.io API (for current affairs news) (REQUIRED)
# Get your API key from https://newsdata.io/
# Free tier: 200 requests/day
# Used for: Current Affairs news aggregation, Daily Quiz generation
NEWSDATA_API_KEY=

# Optional: Mistral AI (Legacy - not currently used)
MISTRAL_API_KEY=

# Optional: Google Cloud Text-to-Speech API Key
# Get your API key from Google Cloud Console (same as GEMINI_API_KEY works)
# Free tier: 1 million characters/month
# Enable the Cloud Text-to-Speech API and use your existing Google API key
GOOGLE_TTS_API_KEY=

# Upstash Redis (for chat history storage) (REQUIRED)
# Get your credentials from https://upstash.com/
# Free tier: 10,000 commands/day
# Used for: Chat history storage with 90-day TTL
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (for email notifications) (REQUIRED)
# Get your API key from https://resend.com/
# Free tier: 100 emails/day, 3,000 emails/month
# Used for: Welcome emails, Copy evaluation notifications, Daily digest
RESEND_API_KEY=

